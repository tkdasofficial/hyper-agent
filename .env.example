# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://ubpxaotwigtpsptiivao.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://ubpxaotwigtpsptiivao.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=ubpxaotwigtpsptiivao
SUPABASE_ACCESS_TOKEN=

# Cloudflare Workers AI Credentials (Llama 3.1 8B Instruct)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Pixazo API Credentials (Flux Schnell & TTS)
PIXAZO_API_KEY=

# GitHub Automation Credentials (repository_dispatch)
GITHUB_PAT=
GITHUB_REPO=
